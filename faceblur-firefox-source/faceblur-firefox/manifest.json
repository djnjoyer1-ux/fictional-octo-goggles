{
  "manifest_version": 2,
  "name": "FaceBlur Local",
  "version": "0.1.0",
  "description": "Detects faces locally and blurs only the face regions on web pages.",
  "permissions": ["storage", "<all_urls>"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {
    "default_title": "FaceBlur Local",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["vendor/face-api.min.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "web_accessible_resources": ["models/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "faceblur-local@example.local",
      "strict_min_version": "109.0"
    }
  }
}
